{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2021", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@nutri/tools/*": ["tools/src/*"],
      "@nutri/client-auth": ["libs/client/auth/src/index.ts"],
      "@nutri/client-gql": ["libs/client/gql/src/index.ts"],
      "@nutri/client-recipes": ["libs/client/recipes/src/index.ts"],
      "@nutri/client-ui": ["libs/client/ui/src/index.ts"],
      "@nutri/client-ui/*": ["libs/client/ui/src/lib/*"],
      "@nutri/client-utils": ["libs/client/utils/src/index.ts"],
      "@nutri/common-consts": ["libs/common/consts/src/index.ts"],
      "@nutri/common-interfaces": ["libs/common/interfaces/src/index.ts"],
      "@nutri/data-import": ["libs/data-import/src/index.ts"],
      "@nutri/data-import-usda": ["libs/data-import-usda/src/index.ts"],
      "@nutri/emails": ["libs/emails/src/index.ts"],
      "@nutri/server-auth": ["libs/server/auth/src/index.ts"],
      "@nutri/server-config": ["libs/server/config/src/index.ts"],
      "@nutri/server-config/*": ["libs/server/config/src/lib/*"],
      "@nutri/server-context": ["libs/server/context/src/index.ts"],
      "@nutri/server-data-access-foods": [
        "libs/server/data-access/foods/src/index.ts"
      ],
      "@nutri/server-data-access-matching": [
        "libs/server/data-access/matching/src/index.ts"
      ],
      "@nutri/server-data-access-recipes": [
        "libs/server/data-access/recipes/src/index.ts"
      ],
      "@nutri/server-data-access-user": [
        "libs/server/data-access-users/src/index.ts"
      ],
      "@nutri/server-db-client": ["libs/server/db-client/src/index.ts"],
      "@nutri/server-email-renderer": [
        "libs/server/email-renderer/src/index.ts"
      ],
      "@nutri/server-import-recipe": ["libs/server/import-recipe/src/index.ts"],
      "@nutri/server-ingredient-matching": [
        "libs/server/ingredient-matching/src/index.ts"
      ],
      "@nutri/server-mailer": ["libs/server/mailer/src/index.ts"],
      "@nutri/server-mailer-renderer": [
        "libs/server/mailer-renderer/src/index.ts"
      ],
      "@nutri/server-metrics": ["libs/server/metrics/src/index.ts"],
      "@nutri/server-ml": ["libs/server/ml/src/index.ts"],
      "@nutri/server-parse-recipe": ["libs/server/parse-recipe/src/index.ts"],
      "@nutri/server-queue": ["libs/server/queue/src/index.ts"],
      "@nutri/server-recipe-import": ["libs/server/recipe-import/src/index.ts"],
      "@nutri/server-redis": ["libs/server/redis/src/index.ts"],
      "@nutri/server-shared": ["libs/server/shared/src/index.ts"],
      "@nutri/server-testing": ["libs/server/testing/src/index.ts"],
      "@nutri/store": ["apps/client/src/store"],
      "@nutri/store/*": ["apps/client/src/store/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
