FROM python:3.9-slim

RUN apt-get update && apt-get install -y \
    postgresql-client \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    csvkit \
    psycopg2-binary \
    pandas \
    openpyxl \
    xlrd \
    pyyaml \
    chardet

CMD ["/bin/bash"]
