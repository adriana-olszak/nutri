FROM python:3.9-alpine

# Install required system dependencies
RUN apk add --no-cache \
    postgresql-client \
    postgresql-dev \
    gcc \
    g++ \
    musl-dev \
    libffi-dev \
    make \
    # Required for pandas
    py3-numpy \
    # For Excel support
    openblas-dev

# Install Python packages
RUN pip install --no-cache-dir \
    csvkit \
    psycopg2-binary \
    pandas \
    openpyxl \
    xlrd \
    pyyaml \
    chardet

CMD ["/bin/bash"]
