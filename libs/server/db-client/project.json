{
  "name": "server-db-client",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/server/db-client",
  "projectType": "library",
  "tags": [],
  "targets": {
    "prisma": {
      "command": "prisma",
      "options": {
        "cwd": "libs/server/db-client"
      }
    },
    "generate-types": {
      "command": "prisma generate --schema=libs/server/db-client/prisma/schema.prisma"
    },
    "migrate": {
      "command": "prisma migrate dev",
      "options": {
        "cwd": "libs/server/db-client"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/server/db-client/**/*.ts"]
      }
    }
  }
}
