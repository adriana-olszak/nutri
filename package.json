  "scripts": {
    "dev": "npx nx run-many -t serve",
    "docs:serve": "nx serve docs",
    "docs:build": "nx build docs",
    "docs:clean": "nx clean docs",
    "client:serve": "nx serve client",
    "client:gql:codegen": "npx nx run client-gql:gen",
    "server:serve": "nx serve server",
    "data:import:usda": "npx nx run data-import-usda:import",
    "data:import:otto": "npx nx run data-import:import:otto",
    "data:import:canada": "npx nx run data-import-canada:run",
    "db:nutri:reset:full": "docker-compose down -v && docker-compose up -d && echo 'waiting for import to finish' && docker wait $(docker-compose ps -q csvkit-importer) && pnpm db:nutri:migrate && pnpm data:import:canada && pnpm data:import:otto",
    "db:nutri:reset": "docker-compose down -v && docker-compose up -d && pnpm db:nutri:migrate",
    "db:nutri:migrate": "npx nx run server-db-client:migrate",
    "db:nutri:client": "npx nx run server-db-client:generate-types",
    "db:nutri:dump": "./tools/dump-database.sh nutri postgres-nutri",
    "db:nutri:tui": "harlequin -a postgres -h localhost -p 3100 -U nutri --password nutri -d nutri",
    "docker:server:build": "docker build -t server:test -f deploy/dockerfiles/server/Dockerfile .",
    "docker:server:run": "docker run -it --rm -p 4100:4100 --env-file .env -e REDIS_HOST=host.docker.internal -e DATABASE_URL=postgresql://nutri:nutri@host.docker.internal:3100/nutri -e SERVER_BASE_URL=http://host.docker.internal:4100 -e CLIENT_BASE_URL=http://host.docker.internal:4200 server:test -e LLM_BASE_URL=http://host.docker.internal:1234"
  },
