{
  "name": "ml",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ml/ml",
  "targets": {
    "lock": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry lock --no-update",
        "cwd": "apps/ml"
      }
    },
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "build": {
      "executor": "@nxlv/python:build",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "apps/ml/dist",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true
      }
    },
    "serve": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run flask run",
        "cwd": "apps/ml/ml"
      }
    },
    "worker": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python worker.py",
        "cwd": "apps/ml/ml"
      }
    },
    "queue": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run procrastinate --app=ml.tasks.procrastinate.procrastinate_app schema --apply",
        "cwd": "apps/ml/ml"
      }
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "cacheDir": ".cache/pypoetry",
        "verbose": false,
        "debug": false
      }
    },
    "lint": {
      "executor": "@nxlv/python:flake8",
      "outputs": [
        "{workspaceRoot}/reports/apps/ml/pylint.txt"
      ],
      "options": {
        "outputFile": "reports/apps/ml/pylint.txt"
      }
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/apps/ml/unittests",
        "{workspaceRoot}/coverage/apps/ml"
      ],
      "options": {
        "command": "poetry run pytest tests/",
        "cwd": "apps/ml"
      }
    }
  },
  "tags": []
}
